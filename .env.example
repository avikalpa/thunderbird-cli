# Default cache backend for tb is SQLite.
# Set this only if you explicitly want PostgreSQL instead.
# TB_STORE=postgres
# TB_PG_DSN=postgres://tbcli:CHANGE_ME@localhost/tb_cli?sslmode=disable

# Optional override for the SQLite state path.
# TB_SQLITE_PATH=$HOME/.local/state/thunderbird-cli/dev/index-v1.db
